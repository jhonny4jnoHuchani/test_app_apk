{
  "expo": {
    "name": "Quest Estudiante",
    "slug": "quest-estudiante",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quest-estudiante",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/expo.icon"
    },
   
    "android": {
      "package": "com.desarrollo9.questestudiante",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#F3E4BC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3E4BC",
          "image": "./assets/items/Portada.png",
          "imageWidth": 320
        }
      ],
      "expo-secure-store",
      [
        "expo-navigation-bar",
        {
          "hidden": false,
          "style": "dark"
        }
      ],
      "expo-font",
      "./withCleartextTraffic.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "style": "dark",
        "hidden": false
      },
      "eas": {
        "projectId": "c7004f06-0cd2-4482-b1f1-c04c99cb7de9"
      }
    },
    "owner": "jhonny_ajno"
  }
}
